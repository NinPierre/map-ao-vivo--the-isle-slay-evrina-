PORT=3001
# Se o servidor do jogo estiver em outra maquina, use o IP dela aqui.
RCON_HOST=127.0.0.1
RCON_PORT=5555
RCON_PASSWORD=genomaslot
RCON_CONNECT_TIMEOUT_MS=15000
RCON_RESPONSE_TIMEOUT_MS=15000
RCON_IDLE_RESPONSE_MS=180
RCON_CACHE_TTL_MS=1500
MAP_MIN_COORD=-320000
MAP_MAX_COORD=320000

# Discord voice bot
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
DISCORD_PRESENCE_STATUS=dnd
DISCORD_SELF_MUTE=true
DISCORD_SELF_DEAF=true
DISCORD_RECONNECT_DELAY_MS=5000

# Cloudflare quick tunnel
CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe
CLOUDFLARED_TARGET=http://127.0.0.1:3001
CLOUDFLARED_ARGS=--no-autoupdate

# Portable panel behavior
AUTO_START_MAP=false
AUTO_START_BOT=false
AUTO_START_TUNNEL=false
